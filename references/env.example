# Seed Audiobook Generator environment template
# Copy to .env and fill in only the values needed for your run.

# Configurable planner / Ark-compatible rewrite
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
LLM_API_KEY=
LLM_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEED_AUDIO_REWRITE_MODEL=dola-seed-2-1-turbo-260628
SEED_AUDIO_MAX_STRUCTURAL_REPLANS=3
SEED_AUDIO_MAX_STAGNANT_REPLANS=2
LLM_MODEL=dola-seed-2-1-turbo-260628
LLM_SYSTEM_PROMPT=

# Seed Audio 1.0 generation
SEED_AUDIO_API_KEY=
SEED_AUDIO_URL=https://voice.ap-southeast-1.bytepluses.com/api/v3/tts/create
SEED_AUDIO_MODEL=seed-audio-1.0
SEED_AUDIO_FORMAT=wav
SEED_AUDIO_SAMPLE_RATE=24000
SEED_AUDIO_SPEECH_RATE=0
SEED_AUDIO_LOUDNESS_RATE=0
SEED_AUDIO_PITCH_RATE=0
SEED_AUDIO_TIMEOUT=120
SEED_AUDIO_MAX_CHARS=2048
SEED_AUDIO_TARGET_CHARS=2200
SEED_AUDIO_EN_SPEECH_RATE=4

# Optional legacy Seed Audio auth
SEED_AUDIO_APP_ID=
SEED_AUDIO_ACCESS_KEY=

# Optional TTS for dry reference voices.
# Not required when every role uses reference_mode=speaker.
TTS_API_KEY=
TTS_URL=https://voice.ap-southeast-1.bytepluses.com/api/v3/tts/unidirectional
TTS_RESOURCE_ID=seed-tts-2.0
TTS_APP_KEY=
TTS_SPEAKER=
TTS_FORMAT=mp3
TTS_SAMPLE_RATE=24000

# Optional fixed speaker overrides for the bundled demo
SEED_AUDIO_SPEAKER_NARRATOR=
SEED_AUDIO_SPEAKER_ELIAN=
SEED_AUDIO_SPEAKER_MARA=
SEED_AUDIO_SPEAKER_ARMOR=
SEED_AUDIO_SPEAKER_PORTRAIT=

# Optional fixed speaker overrides for the Chapter 28 case
SEED_AUDIO_SPEAKER_HARRY_POTTER=
SEED_AUDIO_SPEAKER_SEVERUS_SNAPE=
SEED_AUDIO_SPEAKER_DRACO_MALFOY=
SEED_AUDIO_SPEAKER_HAGRID=
SEED_AUDIO_SPEAKER_GINNY_WEASLEY=
SEED_AUDIO_SPEAKER_MINERVA_MCGONAGALL=
SEED_AUDIO_SPEAKER_DEATH_EATER=

# ASR language gate
LAS_API_KEY=
ASR_API_KEY=
ASR_SUBMIT_URL=https://operator.las.ap-southeast-1.bytepluses.com/api/v1/submit
ASR_QUERY_URL=https://operator.las.ap-southeast-1.bytepluses.com/api/v1/poll
ASR_SOURCE_LANGUAGE=en-US
ASR_MODEL_NAME=bigmodel
ASR_POLL_INTERVAL=5
ASR_POLL_TIMEOUT=900

# Local tools
FFMPEG_PATH=
DOWNLOAD_TIMEOUT=600
DOWNLOAD_RETRIES=3
