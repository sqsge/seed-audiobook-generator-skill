# Copy this file to .env. Do not commit .env or any real credentials.
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
LLM_API_KEY=
LLM_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
LLM_MODEL=dola-seed-2-1-turbo-260628
SEED_AUDIO_REWRITE_MODEL=dola-seed-2-1-turbo-260628
SEED_AUDIO_REVIEW_MODEL=seed-2-0-lite-260428

SEED_AUDIO_API_KEY=
SEED_AUDIO_URL=https://voice.ap-southeast-1.bytepluses.com/api/v3/tts/create
SEED_AUDIO_MODEL=seed-audio-1.0
SEED_AUDIO_FORMAT=wav
SEED_AUDIO_SAMPLE_RATE=24000
SEED_AUDIO_TIMEOUT=120

# Optional: required only for generated dry reference voices.
TTS_API_KEY=
TTS_URL=https://voice.ap-southeast-1.bytepluses.com/api/v3/tts/unidirectional
TTS_RESOURCE_ID=seed-tts-2.0

# Optional ASR gate; normal delivery keeps this off.
ASR_API_KEY=
ASR_SUBMIT_URL=https://operator.las.ap-southeast-1.bytepluses.com/api/v1/submit
ASR_QUERY_URL=https://operator.las.ap-southeast-1.bytepluses.com/api/v1/poll

# Local executable override; otherwise ffmpeg must be on PATH.
FFMPEG_PATH=
